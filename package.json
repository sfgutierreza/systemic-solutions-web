{
  "name": "systemic-web",
  "private": true,
  "version": "1.0.0",
  "description": "Sitio web de Systemic Solutions (systemic.pe). Paginas estaticas; la unica dependencia es Tailwind, que compila el CSS de las paginas.",
  "scripts": {
    "build": "tailwindcss -c tailwind.stitch.config.cjs -i styles/stitch-tailwind.css -o public/systemic-stitch.css --minify",
    "dev": "tailwindcss -c tailwind.stitch.config.cjs -i styles/stitch-tailwind.css -o public/systemic-stitch.css --watch",
    "serve": "npx --yes serve public -l 4173"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
